{
  "name": "the-void-e2e",
  "private": true,
  "version": "0.0.0",
  "description": "Playwright E2E tests for The Void (Flutter web)",
  "scripts": {
    "install:browsers": "playwright install chromium",
    "test": "playwright test",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "test:report": "playwright show-report",
    "build:app": "cd .. && flutter build web --dart-define-from-file=.env.json --dart-define=E2E=true"
  },
  "devDependencies": {
    "@playwright/test": "^1.48.0",
    "dotenv": "^16.4.5"
  }
}
